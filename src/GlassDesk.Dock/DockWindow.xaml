<controls:GlassWindow
    x:Class="GlassDesk.Dock.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
    Title="LG Dsk Dock"
    AutomationProperties.Name="LG Dsk 程序坞"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    AllowDrop="True"
    Drop="OnExternalDrop"
    DragOver="OnExternalDragOver">

  <controls:GlassWindow.Resources>
    <!-- Pixel artwork traced from the supplied references. Transparent margins let
         the original 1.5.0 LiquidGlassSurface remain the single dock background. -->
    <BitmapImage x:Key="FinderIcon"
                 UriSource="pack://application:,,,/GlassDesk.Dock;component/Assets/UserReference/finder-icon.png" />
    <BitmapImage x:Key="SettingsIcon"
                 UriSource="pack://application:,,,/GlassDesk.Dock;component/Assets/UserReference/settings-icon.png" />
    <BitmapImage x:Key="DownloadsIcon"
                 UriSource="pack://application:,,,/GlassDesk.Dock;component/Assets/UserReference/downloads-icon.png" />
    <BitmapImage x:Key="RecycleBinIcon"
                 UriSource="pack://application:,,,/GlassDesk.Dock;component/Assets/UserReference/trash-icon.png" />

    <Style x:Key="DockKeyboardFocusVisual" TargetType="{x:Type Control}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Control}">
            <Border Margin="-3" Background="#22FFFFFF" BorderBrush="#E6FFFFFF"
                    BorderThickness="2" CornerRadius="14">
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DockEntryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource DockKeyboardFocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <!-- LiquidGlassSurface is the only Dock backdrop. Content is arranged into
       Favorites, Recent Applications, and Files/System Objects zones. -->
  <Border
      Background="Transparent"
      BorderThickness="0"
      SnapsToDevicePixels="True">

    <Grid ClipToBounds="True">
      <!-- Glass remains in screen coordinates; the live shared silhouette slides over it. -->
    <controls:LiquidGlassSurface x:Name="GlassSurface" UseWarmSafeFallback="True" />
      <Grid x:Name="DockVisualRoot" ClipToBounds="True" RenderTransformOrigin="0,0">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="DockSlideTransform" />
        </Grid.RenderTransform>
        <StackPanel x:Name="DockContentLayer" Orientation="Vertical" Margin="10,8">

      <Grid x:Name="DockEntriesRow" Background="Transparent" VerticalAlignment="Center"
            MouseMove="OnDockEntriesRowMouseMove" MouseLeave="OnDockEntriesRowMouseLeave">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="DockFavoritesGroup" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Canvas x:Name="DockLeadingEntries" VerticalAlignment="Center" ClipToBounds="False">
        <Button x:Name="FinderButton" Width="48" Height="64" Padding="0"
                Style="{StaticResource DockEntryButton}"
                ToolTip="文件管理器" AutomationProperties.Name="打开文件管理器"
                Click="OnFinderButtonClick">
          <Image x:Name="FinderTile" Width="48" Height="48" Source="{StaticResource FinderIcon}" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
        </Button>
        <Button x:Name="SettingsButton" Width="48" Height="64" Padding="0"
                Style="{StaticResource DockEntryButton}"
                ToolTip="设置" AutomationProperties.Name="打开设置"
                Click="OnSettingsButtonClick">
          <Image x:Name="SettingsTile" Width="48" Height="48" Source="{StaticResource SettingsIcon}" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
        </Button>
        <Button x:Name="LauncherButton" Width="48" Height="64" Padding="0"
                Style="{StaticResource DockEntryButton}"
                Background="Transparent" BorderThickness="0"
                ToolTip="启动台" AutomationProperties.Name="打开启动台"
                Click="OnLauncherButtonClick">
          <controls:PhoneBorder x:Name="LaunchpadTile" Width="48" Height="48" CornerRadius="16"
                     BorderThickness="0">
            <controls:PhoneBorder.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF826AF0" Offset="0" />
                <GradientStop Color="#FF4258C9" Offset="1" />
              </LinearGradientBrush>
            </controls:PhoneBorder.Background>
            <controls:LaunchpadGlyph OutlineBrush="#FFF8F8FF" />
          </controls:PhoneBorder>
        </Button>
        <Button x:Name="ThisPcButton" Width="48" Height="64" Padding="0"
                Style="{StaticResource DockEntryButton}"
                Background="Transparent" BorderThickness="0"
                ToolTip="此电脑" AutomationProperties.Name="打开此电脑"
                Click="OnThisPcButtonClick">
          <Border Background="#FF2F78D7" CornerRadius="12">
            <Viewbox x:Name="ThisPcTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
              <Path Data="M9,9 H39 Q42,9 42,12 V30 Q42,33 39,33 H9 Q6,33 6,30 V12 Q6,9 9,9 Z M24,33 V39 M16,40 H32"
                    Fill="Transparent"
                    Stroke="#FFF5FAFF"
                    StrokeThickness="3" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
            </Viewbox>
          </Border>
        </Button>
        </Canvas>
        <ContentControl x:Name="TileStripHost" HorizontalAlignment="Left"
                        AutomationProperties.Name="固定应用" Focusable="False" />
        </StackPanel>

        <Border x:Name="LeadingGroupDivider" Grid.Column="1" Width="1" Height="32" Margin="8,0,8,0"
                Background="#667A7168" VerticalAlignment="Center" Visibility="Collapsed" />

        <ScrollViewer x:Name="RecentApplicationsViewport" Grid.Column="2" VerticalAlignment="Center"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="False" Focusable="False" Visibility="Collapsed">
        <ItemsControl x:Name="RecentApplicationsHost" VerticalAlignment="Center"
                      AutomationProperties.Name="最近使用的应用">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><Canvas ClipToBounds="False" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
              <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
              <Setter Property="Panel.ZIndex" Value="{Binding MagnificationZIndex}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Width="{Binding IconSize}" Height="{Binding TileHeight}" Padding="0"
                      AllowDrop="True"
                      RenderTransformOrigin="0.5,0.5"
                      Style="{StaticResource DockEntryButton}"
                      ToolTip="{Binding ToolTipText}"
                      AutomationProperties.Name="{Binding DisplayName}"
                      AutomationProperties.AutomationId="{Binding EntryId}"
                      AutomationProperties.HelpText="{Binding ToolTipText}"
                      AutomationProperties.ItemStatus="{Binding RunningAutomationStatus}"
                      PreviewMouseLeftButtonDown="OnRecentApplicationMouseDown"
                      MouseMove="OnRecentApplicationMouseMove"
                      DragOver="OnApplicationFileDragOver"
                      Drop="OnRecentApplicationFileDrop"
                      PreviewMouseRightButtonUp="OnRecentApplicationRightClick"
                      Click="OnRecentApplicationClick">
                <Button.RenderTransform>
                  <ScaleTransform ScaleX="{Binding MagnificationScale}" ScaleY="{Binding MagnificationScale}" />
                </Button.RenderTransform>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Image x:Name="RecentApplicationImage" Width="{Binding IconSize}" Height="{Binding IconSize}"
                         Source="{Binding Icon}" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
                  <Ellipse Width="5" Height="5" Margin="0,2,0,0"
                           HorizontalAlignment="Center" Fill="{Binding DotBrush}"
                           Visibility="{Binding RunningVisibility}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>

        <Border x:Name="TrailingGroupDivider" Grid.Column="4" Width="1" Height="32" Margin="8,0,8,0"
                Background="#667A7168" VerticalAlignment="Center" />

        <Canvas x:Name="DockTrailingEntries" Grid.Column="5" VerticalAlignment="Center" ClipToBounds="False">
          <Button x:Name="DownloadsButton" Width="48" Height="64" Margin="0" Padding="0"
                    Style="{StaticResource DockEntryButton}"
                    ToolTip="下载" AutomationProperties.Name="打开下载文件夹"
                    Click="OnDownloadsButtonClick">
            <Image x:Name="DownloadsTile" Width="48" Height="48" Source="{StaticResource DownloadsIcon}" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
          </Button>
          <Button x:Name="RecycleBinButton" Width="48" Height="64" Margin="0" Padding="0"
                    AllowDrop="True"
                    Style="{StaticResource DockEntryButton}"
                    ToolTip="回收站" AutomationProperties.Name="打开回收站"
                    DragOver="OnRecycleBinDragOver" DragLeave="OnRecycleBinDragLeave"
                    Drop="OnRecycleBinDrop" PreviewMouseRightButtonUp="OnRecycleBinRightClick"
                    Click="OnRecycleBinButtonClick">
            <Grid Width="48" Height="48">
              <!-- Paper is drawn behind the supplied translucent, borderless bin artwork. -->
              <Canvas x:Name="RecycleBinContentsOverlay" Width="48" Height="48"
                      IsHitTestVisible="False" Visibility="Collapsed">
                <Border Canvas.Left="17" Canvas.Top="22" Width="14" Height="12"
                        Background="#FFF7F4EA" CornerRadius="1" RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform><RotateTransform Angle="-9" /></Border.RenderTransform>
                </Border>
                <Border Canvas.Left="22" Canvas.Top="25" Width="13" Height="11"
                        Background="#FFECE7D9" CornerRadius="1" RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform><RotateTransform Angle="8" /></Border.RenderTransform>
                </Border>
              </Canvas>
              <Image x:Name="RecycleBinTile" Width="48" Height="48" Source="{StaticResource RecycleBinIcon}" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
            </Grid>
          </Button>
        </Canvas>
      </Grid>

      <TextBlock
          x:Name="StatusText"
          Margin="2,8,2,0"
          HorizontalAlignment="Center"
          FontSize="11"
          Visibility="Collapsed"
          Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />

        </StackPanel>

        <Border x:Name="SwitcherContentLayer" Margin="10,8" Visibility="Collapsed"
                Background="Transparent" IsHitTestVisible="True" Panel.ZIndex="1"
                MouseEnter="OnSwitcherHoverEnter" MouseLeave="OnSwitcherHoverLeave">
          <StackPanel>
            <DockPanel Margin="8,0,8,5" LastChildFill="True">
              <Button x:Name="CloseSwitcherButton" DockPanel.Dock="Right" Width="26" Height="24"
                      Padding="0" Content="×" FontSize="17" Background="Transparent" BorderThickness="0"
                      ToolTip="收起应用条" AutomationProperties.Name="收起运行应用条"
                      Click="OnCloseSwitcherClick" />
              <TextBlock x:Name="SwitcherPowerText" DockPanel.Dock="Right" Margin="8,0,8,0"
                         VerticalAlignment="Center" FontSize="9" MaxWidth="180" TextTrimming="CharacterEllipsis"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock x:Name="SwitcherActivityText" DockPanel.Dock="Right" Margin="4,0,8,0"
                         VerticalAlignment="Center" FontSize="10" MaxWidth="180" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                         Foreground="#FFC86B4F" />
              <TextBlock x:Name="SwitcherSummaryText" VerticalAlignment="Center" FontSize="11"
                         Text="窗口 0 · 后台 0"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DockPanel>
            <TextBlock Margin="8,0,8,5" Text="点击窗口即可切换；后台项表示进程仍在运行，但当前没有可切换窗口。"
                       FontSize="9"
                       Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock x:Name="SwitcherTimerStatusText" Margin="8,2,8,4"
                       Text="快捷倒计时（仅本次运行期间有效） · 暂无计时器" FontSize="9"
                       Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <WrapPanel Margin="6,0,6,6" Orientation="Horizontal">
              <Button Content="5 分钟" Tag="5" Margin="2" Padding="8,3" Focusable="False"
                      AutomationProperties.Name="开始五分钟倒计时" Click="OnIslandTimerPresetClick" />
              <Button Content="15 分钟" Tag="15" Margin="2" Padding="8,3" Focusable="False"
                      AutomationProperties.Name="开始十五分钟倒计时" Click="OnIslandTimerPresetClick" />
              <Button Content="25 分钟" Tag="25" Margin="2" Padding="8,3" Focusable="False"
                      AutomationProperties.Name="开始二十五分钟倒计时" Click="OnIslandTimerPresetClick" />
              <Button Content="45 分钟" Tag="45" Margin="2" Padding="8,3" Focusable="False"
                      AutomationProperties.Name="开始四十五分钟倒计时" Click="OnIslandTimerPresetClick" />
              <Button Content="暂停全部" Margin="2" Padding="8,3" Focusable="False"
                      Click="OnIslandTimerPauseClick" />
              <Button Content="继续全部" Margin="2" Padding="8,3" Focusable="False"
                      Click="OnIslandTimerResumeClick" />
              <Button Content="清除全部" Margin="2" Padding="8,3" Focusable="False"
                      Click="OnIslandTimerClearClick" />
            </WrapPanel>
            <TextBlock x:Name="NoRunningAppsText" Margin="12,6" HorizontalAlignment="Center"
                       Text="暂未检测到应用；仍可使用 Windows 的 Alt+Tab。"
                       FontSize="11" Visibility="Collapsed"
                       Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <ScrollViewer x:Name="RunningAppsScrollViewer" HorizontalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnSwitcherMouseWheel">
              <ItemsControl x:Name="RunningAppsItems" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="62" Height="74" Margin="2,0" Padding="2"
                            IsEnabled="{Binding IsWindowSwitchable}"
                            Background="Transparent" BorderThickness="0" Focusable="False"
                            ToolTip="{Binding ToolTipText}"
                            AutomationProperties.Name="{Binding ToolTipText}"
                            Click="OnSwitcherItemClick">
                      <Border CornerRadius="12" Background="Transparent" Padding="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                          <Grid Width="38" Height="38" HorizontalAlignment="Center">
                            <Border CornerRadius="9" Background="#553A6A9B">
                              <TextBlock Text="{Binding Glyph}" FontSize="18" FontWeight="SemiBold"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Border>
                            <Image Source="{Binding Icon}" Width="38" Height="38" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                          </Grid>
                          <TextBlock Text="{Binding DisplayName}" MaxWidth="58" Margin="0,2,0,0"
                                     FontSize="9" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                     Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                          <TextBlock Text="{Binding StatusLabel}" FontSize="7" TextAlignment="Center"
                                     Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <Border x:Name="AppIslandContentLayer" Margin="10,8" Visibility="Collapsed"
                Background="Transparent" IsHitTestVisible="True" Panel.ZIndex="2">
          <Button x:Name="AppIslandButton" MinWidth="176" MaxWidth="440" MinHeight="44" Padding="12,5"
                  Background="Transparent" BorderThickness="0" Focusable="False"
                  ToolTip="鼠标经过展开应用岛；显示固定应用、窗口、后台和可读取的托盘项目"
                  AutomationProperties.Name="展开 LG Dsk 应用岛"
                  MouseEnter="OnAppIslandMouseEnter"
                  Click="OnAppIslandClick">
            <Border CornerRadius="18" Background="#33201B18" Padding="6,3">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="14" Background="#FFE2D4C4" Margin="0,0,8,0">
                  <TextBlock Text="LG" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Foreground="#FFB65B43" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="LG Dsk" FontSize="10" FontWeight="SemiBold"
                             Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBlock x:Name="AppIslandCountsText" Text="窗口 0 · 后台 0" FontSize="8" MaxWidth="330" TextTrimming="CharacterEllipsis"
                             Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBlock x:Name="AppIslandActivityText" FontSize="7" MaxWidth="330" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                             Foreground="#FFC86B4F" />
                  <TextBlock x:Name="AppIslandPowerText" Text="电源状态读取中" FontSize="7" MaxWidth="330" TextTrimming="CharacterEllipsis"
                             Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <TextBlock Text="✳" Margin="8,0,0,0" FontSize="15" Foreground="#FFC86B4F"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Button>
        </Border>
      </Grid>
    </Grid>
  </Border>

</controls:GlassWindow>

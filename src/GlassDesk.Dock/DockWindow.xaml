<controls:GlassWindow
    x:Class="GlassDesk.Dock.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
    Title="LG Dsk Dock"
    AutomationProperties.Name="LG Dsk 程序坞"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    AllowDrop="True"
    Drop="OnExternalDrop"
    DragOver="OnExternalDragOver">

  <controls:GlassWindow.Resources>
    <Style x:Key="DockEntryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <!--
    图标行是真实的应用磁贴（D-07/D-08）。磁贴条（放大、滚动、命中）由
    DockTileStrip 承担；这里的宿主只负责把它嵌进玻璃面板。
  -->
  <Border
      Background="Transparent"
      BorderThickness="0"
      SnapsToDevicePixels="True">

    <Grid ClipToBounds="True">
      <!-- Glass remains in screen coordinates; the live shared silhouette slides over it. -->
      <controls:LiquidGlassSurface x:Name="GlassSurface" />
      <Grid x:Name="DockVisualRoot" ClipToBounds="True" RenderTransformOrigin="0,0">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="DockSlideTransform" />
        </Grid.RenderTransform>
        <StackPanel x:Name="DockContentLayer" Orientation="Vertical" Margin="10,8">

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="LauncherButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                Style="{StaticResource DockEntryButton}"
                Background="Transparent" BorderThickness="0"
                ToolTip="启动台" AutomationProperties.Name="打开启动台"
                MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                Click="OnLauncherButtonClick">
          <controls:PhoneBorder x:Name="LaunchpadTile" Width="48" Height="48" CornerRadius="16"
                     Background="Transparent" BorderThickness="0">
            <controls:LaunchpadGlyph OutlineBrush="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
          </controls:PhoneBorder>
        </Button>
        <Button x:Name="ThisPcButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                Style="{StaticResource DockEntryButton}"
                Background="Transparent" BorderThickness="0"
                ToolTip="此电脑" AutomationProperties.Name="打开此电脑"
                MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                Click="OnThisPcButtonClick">
          <Viewbox x:Name="ThisPcTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
              <Path Data="M6,6 H42 Q45,6 45,9 V29 Q45,32 42,32 H6 Q3,32 3,29 V9 Q3,6 6,6 Z M24,32 V39 M15,40 H33"
                    Fill="Transparent"
                    Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    StrokeThickness="3.5" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
        </Button>
        <Button x:Name="DesktopIconsButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                Style="{StaticResource DockEntryButton}"
                ToolTip="切换桌面图标显示" AutomationProperties.Name="切换桌面图标显示"
                MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                Click="OnDesktopIconsButtonClick">
          <Viewbox x:Name="DesktopIconsTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
              <Path Data="M6,6 H42 Q45,6 45,9 V29 Q45,32 42,32 H6 Q3,32 3,29 V9 Q3,6 6,6 Z M24,32 V39 M15,40 H33"
                    Fill="Transparent"
                    Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    StrokeThickness="3.5" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Path Data="M11,12 H15 V16 H11 Z M11,22 H15 V26 H11 Z M23,15 H37 M32,10 L37,15 L32,20 M37,24 H23 M28,19 L23,24 L28,29"
                    Fill="Transparent"
                    Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    StrokeThickness="3.5" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
        </Button>
        <ContentControl x:Name="TileStripHost"
                        AutomationProperties.Name="固定的应用"
                        Focusable="False" />
      </StackPanel>

      <TextBlock
          x:Name="StatusText"
          Margin="2,8,2,0"
          HorizontalAlignment="Center"
          FontSize="11"
          Visibility="Collapsed"
          Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />

        </StackPanel>

        <Border x:Name="SwitcherContentLayer" Margin="10,8" Visibility="Collapsed"
                Background="Transparent" IsHitTestVisible="True" Panel.ZIndex="1">
          <StackPanel>
            <DockPanel Margin="8,0,8,5" LastChildFill="True">
              <Button x:Name="CloseSwitcherButton" DockPanel.Dock="Right" Width="26" Height="24"
                      Padding="0" Content="×" FontSize="17" Background="Transparent" BorderThickness="0"
                      ToolTip="收起应用条" AutomationProperties.Name="收起运行应用条"
                      Click="OnCloseSwitcherClick" />
              <TextBlock x:Name="SwitcherSummaryText" VerticalAlignment="Center" FontSize="11"
                         Text="窗口 0 · 后台 0"
                         Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DockPanel>
            <TextBlock Margin="8,0,8,5" Text="点击窗口即可切换；后台项表示进程仍在运行，但当前没有可切换窗口。"
                       FontSize="9"
                       Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock x:Name="NoRunningAppsText" Margin="12,6" HorizontalAlignment="Center"
                       Text="暂未检测到应用；仍可使用 Windows 的 Alt+Tab。"
                       FontSize="11" Visibility="Collapsed"
                       Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <ScrollViewer x:Name="RunningAppsScrollViewer" HorizontalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnSwitcherMouseWheel">
              <ItemsControl x:Name="RunningAppsItems" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="62" Height="74" Margin="2,0" Padding="2"
                            IsEnabled="{Binding IsWindowSwitchable}"
                            Background="Transparent" BorderThickness="0" Focusable="False"
                            ToolTip="{Binding ToolTipText}"
                            AutomationProperties.Name="{Binding ToolTipText}"
                            Click="OnSwitcherItemClick">
                      <Border CornerRadius="12" Background="Transparent" Padding="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                          <Grid Width="38" Height="38" HorizontalAlignment="Center">
                            <Border CornerRadius="9" Background="#553A6A9B">
                              <TextBlock Text="{Binding Glyph}" FontSize="18" FontWeight="SemiBold"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Border>
                            <Image Source="{Binding Icon}" Width="38" Height="38" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                          </Grid>
                          <TextBlock Text="{Binding DisplayName}" MaxWidth="58" Margin="0,2,0,0"
                                     FontSize="9" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                     Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                          <TextBlock Text="{Binding StatusLabel}" FontSize="7" TextAlignment="Center"
                                     Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <Border x:Name="AppIslandContentLayer" Margin="10,8" Visibility="Collapsed"
                Background="Transparent" IsHitTestVisible="True" Panel.ZIndex="2">
          <Button x:Name="AppIslandButton" MinWidth="164" Height="42" Padding="12,5"
                  Background="Transparent" BorderThickness="0" Focusable="False"
                  ToolTip="点击查看窗口与后台应用；鼠标经过不会展开"
                  AutomationProperties.Name="展开 LG Dsk 应用岛"
                  Click="OnAppIslandClick">
            <Border CornerRadius="18" Background="#33201B18" Padding="6,3">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="14" Background="#FFE2D4C4" Margin="0,0,8,0">
                  <TextBlock Text="LG" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Foreground="#FFB65B43" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="LG Dsk" FontSize="10" FontWeight="SemiBold"
                             Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBlock x:Name="AppIslandCountsText" Text="窗口 0 · 后台 0" FontSize="8"
                             Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <TextBlock Text="✳" Margin="8,0,0,0" FontSize="15" Foreground="#FFC86B4F"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Button>
        </Border>
      </Grid>
    </Grid>
  </Border>

</controls:GlassWindow>

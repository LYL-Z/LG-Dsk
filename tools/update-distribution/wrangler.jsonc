{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lg-dsk-updates",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../artifacts/update-distribution",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": false
  },
  "routes": [
    { "pattern": "updates.chronokalamos.com", "custom_domain": true }
  ]
}
